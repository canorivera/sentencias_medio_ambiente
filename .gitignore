##############################################################################
# SECRETS & CREDENTIALS - keep these OUT of version control, always
##############################################################################
.Renviron
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*
config/secrets.yml
# API keys, tokens
*api_key*
*token*
.pypirc
.streamlit/secrets.toml

##############################################################################
# DATA - data lives in Dropbox (see DATA_DIR in .env), never in the repo
##############################################################################
data/
*/data/
*data/
raw/
*.dta
*.sav
*.por
*.rds
*.rda
*.RData
*.feather
*.parquet
*.sas7bdat
*.sqlite
*.sqlite3
*.db
*.pkl
*.pickle
*.h5
*.hdf5
# Large / binary tabular files
*.xlsx
*.xls
*.csv
*.tsv
*.json
*.jsonl
# Downloaded documents
*.pdf
*.doc
*.docx
*.zip
*.7z
*.rar
*.tar
*.gz
# --- Whitelist exceptions (uncomment / adjust for small, public files) ---
!**/.env.example
!code/103_classification/codebook.csv

