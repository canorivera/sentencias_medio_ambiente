# Copiar este archivo como .env y llenar los valores.

# Carpeta de datos (fuera del repositorio)
DATA_DIR=C:/ruta/a/Dropbox/research/sentencias_profepa

# Llaves para la etapa de análisis con LLMs (todavía no se usan)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Servidor local de OCR (llama.cpp con PaddleOCR-VL-1.6 en GGUF)
LLAMA_SERVER_EXE=C:/ruta/a/llama.cpp/llama-server.exe
OCR_MODEL_DIR=C:/ruta/a/models/PaddleOCR-VL-1.6-GGUF
OCR_SERVER_URL=http://127.0.0.1:8111
OCR_SERVER_PARALLEL=4

# CLI de Colab (instalado fuera del repositorio)
COLAB_CLI_PYTHON=C:/ruta/a/colab_cli/Scripts/python.exe
COLAB_CLI_WIN=C:/ruta/a/colab_cli/colab_win.py
